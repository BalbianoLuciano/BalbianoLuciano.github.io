---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { FaGithub, FaInstagram, FaLinkedin, FaReact } from 'react-icons/fa';
import { IoLogoJavascript } from 'react-icons/io5';
import { IoLogoFirebase } from 'react-icons/io5';
import { FaLaravel } from 'react-icons/fa6';
import { RiTailwindCssFill } from 'react-icons/ri';
import { RiNextjsLine } from 'react-icons/ri';
import { SiExpo } from 'react-icons/si';
import { SiAstro } from 'react-icons/si';
import { PiMouseScrollThin } from 'react-icons/pi';

const currentYear = new Date().getFullYear();
---

<Layout title="Balbiano Luciano">
  <div class="flex flex-row relative justify-center items-center">
    <div class="container">
      <div
        class="initial-container top-half flex items-center justify-end flex-col"
      >
        <div class="flex flex-col gap-2 items-center">
          <p class="text-[50px] text-dark tracking-widest contact uppercase">
            Socials
          </p>
          <div class="flex gap-2">
            <FaGithub style={{ fontSize: '2em' }} />
            <FaLinkedin style={{ fontSize: '2em' }} />
            <FaInstagram style={{ fontSize: '2em' }} />
          </div>
        </div>
        <h1 class="text-[150px] tracking-widest text-center uppercase">
          Full-stack Developer
        </h1>
        <p class="text-[70px] tracking-widest name uppercase">
          Luciano Balbiano
        </p>
        <i
          class="bi bi-chevron-compact-down text-dark text-[50px] chevron chevron-down"
        ></i>
      </div>
      <div
        class="initial-container bottom-half flex flex-col gap-20 items-center justify-start"
      >
        <div class="flex flex-col gap-2 items-center">
          <i
            class="bi bi-chevron-compact-up text-dark text-[50px] chevron chevron-up"
          ></i>
          <p class="text-[50px] text-dark tracking-widest contact uppercase">
            Main Technologies
          </p>
          <div class="flex gap-2">
            <SiExpo style={{ fontSize: '2em' }} />
            <IoLogoJavascript style={{ fontSize: '2em' }} />
            <IoLogoFirebase style={{ fontSize: '2em' }} />
            <FaLaravel style={{ fontSize: '2em' }} />
            <RiTailwindCssFill style={{ fontSize: '2em' }} />
            <RiNextjsLine style={{ fontSize: '2em' }} />
            <FaReact style={{ fontSize: '2em' }} />
            <SiAstro style={{ fontSize: '2em' }} />
          </div>
        </div>
        <div class="flex flex-col items-center justify-center">
          <p class="text-[50px] text-dark tracking-widest contact uppercase">
            Contact
          </p>
          <div class="flex flex-col gap-2">
            <div
              class="flex items-center text-dark py-2 px-4 rounded-lg font-outfit"
            >
              <i class="bi bi-envelope-fill pr-2"></i>
              <span>balbiano06@gmail.com</span>
            </div>
            <div class="flex items-center justify-center font-outfit">
              <i class="bi bi-telephone-fill pr-2"></i>
              <span>(+54) 9 3735-411941</span>
            </div>
          </div>
        </div>
        <div class="text-sm text-dark font-outfit">
          © BalbianoLuciano™ {currentYear}. All rights reserved.
        </div>
      </div>
      <div class="hidden-container flex justify-center">
        <h2 class="uppercase text-white text-[100px]">Projects</h2>
      </div>
      <div
        id="click-message"
        class="click-message uppercase tracking-widest text-2xl hidden"
      >
        <PiMouseScrollThin style={{ fontSize: '3em', marginRight: '8px' }} />
        Try scrolling
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    height: 200vh; /* Hacemos el contenedor más alto para permitir scroll */
    position: relative;
  }

  .initial-container,
  .hidden-container {
    position: fixed;
    width: 100%;
    height: 50vh;
  }

  .name {
    font-family: 'dharma-gothic-e', sans-serif;
    font-weight: 200;
    font-style: normal;
  }
  .contact {
    font-family: 'dharma-gothic-e', sans-serif;
    font-weight: 800;
    font-style: normal;
  }

  .initial-container h1,
  .hidden-container h2 {
    font-family: 'dharma-gothic-e', sans-serif;
    font-weight: 700;
    font-style: normal;
  }
  .initial-container {
    background-color: white;
    z-index: 1;
  }

  .hidden-container {
    background-color: black;
    height: 100vh;
  }

  .top-half {
    top: 0;
  }

  .bottom-half {
    top: 50vh;
  }

  .chevron {
    opacity: 0;
  }

  .click-message {
    font-family: 'dharma-gothic-e', sans-serif;
    font-weight: 700;
    font-style: normal;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    background: none;
    color: black;
    z-index: 50;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.container',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
        pin: true,
      },
    });

    tl.to(
      '.chevron',
      {
        opacity: 1,
        duration: 0.2,
        ease: 'none',
      },
      0
    )
      .to(
        '.top-half',
        {
          y: '-95vh',
          duration: 1,
          ease: 'none',
        },
        0
      )
      .to(
        '.bottom-half',
        {
          y: '95vh',
          duration: 1,
          ease: 'none',
        },
        0
      );

    const clickMessage = document.getElementById('click-message');

    document.addEventListener('mousemove', (e) => {
      gsap.to(clickMessage, {
        x: e.clientX + 20,
        y: e.clientY + 20,
        duration: 0.1,
        ease: 'power4.out',
      });
    });

    document.querySelectorAll('.initial-container').forEach((container) => {
      container.addEventListener('click', () => {
        clickMessage?.classList.remove('hidden');
        setTimeout(() => {
          clickMessage?.classList.add('hidden');
        }, 500);
      });
    });
  });
</script>
