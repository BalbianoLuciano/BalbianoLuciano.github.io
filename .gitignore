# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Búsqueda laboral: nombra empresas, personas y montos. El repo es público.
jobsearch/aplicaciones/*
!jobsearch/aplicaciones/.gitkeep
jobsearch/TRACKER.md

# Datos que no pueden ser publicos.
jobsearch/PRIVADO.md

# Espontáneas: la cola nombra personas y empresas, y las salidas son mensajes.
jobsearch/espontaneas/objetivos.csv
jobsearch/espontaneas/salidas/*
!jobsearch/espontaneas/salidas/.gitkeep

# Contador del plan 100: el .app se compila con jobsearch/contador/build.sh
jobsearch/contador/Contador.app/

# Exportaciones de LinkedIn: datos de terceros, no se versionan
jobsearch/espontaneas/contactos/

# Preparaciones de entrevista: nombran personas y empresas.
jobsearch/entrevistas/
